# Email nhận thông tin từ form liên hệ trên website
STUDIO_TO_EMAIL=FluffNii.furries@gmail.com

# === CÁCH 1: CLOUDFLARE WORKERS (KHUYÊN DÙNG KHI DEPLOY LÊN CLOUDFLARE) ===
# Tạo tài khoản miễn phí tại https://resend.com và dán API key vào Cloudflare Secrets:
RESEND_API_KEY=re_your_resend_api_key
# Nếu chưa gắn domain riêng ở Resend thì giữ nguyên onboarding@resend.dev
RESEND_FROM=FluffNii Studio <onboarding@resend.dev>

# === CÁCH 2: GMAIL SMTP (CHẠY LOCAL NODE.JS / VERCEL / VPS) ===
# Dùng khi chạy npm run dev trên máy (lưu ý Cloudflare Workers không chạy được SMTP qua nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=FluffNii.furries@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
